{
  "$comment": "Event sequences for packs/context-switch-guard. Each entry is one normalized event; feed it to gate evaluate with --now set to its timestamp. These record what each case is supposed to do, so `npm run verify-examples` can catch a YAML edit that changes an outcome.",
  "pack": "context-switch-guard",
  "timezone": "Asia/Shanghai",
  "sequences": [
    {
      "id": "chat-app-early-in-focus",
      "expect": { "decision": "require_approval", "policy_id": "focus-switch-ask" },
      "why": "Switching into Slack after only two minutes at 10:00 is the interruption this pack exists to make the user confirm.",
      "event": {
        "type": "app_switch",
        "timestamp": "2026-11-20T02:00:00.000Z",
        "source": "manual",
        "context": { "app": "Slack", "project": null, "language": null },
        "duration_seconds": 120
      }
    },
    {
      "id": "browser-dwell-under-two-minutes",
      "expect": { "decision": "suggest", "policy_id": "context-thrash-warning" },
      "why": "A 30-second stay in the browser is the fragmented-switching case; it nudges, never blocks.",
      "event": {
        "type": "app_switch",
        "timestamp": "2026-11-20T02:05:00.000Z",
        "source": "manual",
        "context": { "app": "Chrome", "project": null, "language": null },
        "duration_seconds": 30
      }
    },
    {
      "id": "editor-dwell-one-minute",
      "expect": { "decision": "suggest", "policy_id": "context-thrash-warning" },
      "why": "Leaving the editor after 60 seconds is still a short dwell, so the nudge applies to any app, not only distractions.",
      "event": {
        "type": "app_switch",
        "timestamp": "2026-11-20T06:00:00.000Z",
        "source": "manual",
        "context": { "app": "Code", "project": "agent-gate", "language": "typescript" },
        "duration_seconds": 60
      }
    },
    {
      "id": "evening-long-dwell-is-not-thrash",
      "expect": { "decision": "allow", "policy_id": null },
      "why": "Regression guard: the previous version had a bare `time_window` as the second `any` branch, so any evening switch fired — including after a 15-minute stay. Both branches now require a short dwell.",
      "event": {
        "type": "app_switch",
        "timestamp": "2026-11-20T14:00:00.000Z",
        "source": "manual",
        "context": { "app": "Slack", "project": null, "language": null },
        "duration_seconds": 900
      }
    },
    {
      "id": "evening-short-dwell-still-nudges",
      "expect": { "decision": "suggest", "policy_id": "context-thrash-warning" },
      "why": "The 21:00-23:59 branch keeps a wider 300s threshold, so evening browsing still counts as fragmented.",
      "event": {
        "type": "app_switch",
        "timestamp": "2026-11-20T14:00:00.000Z",
        "source": "manual",
        "context": { "app": "Slack", "project": null, "language": null },
        "duration_seconds": 200
      }
    },
    {
      "id": "deep-block-suppression-asks-first",
      "expect": { "decision": "require_approval", "policy_id": "notify-free-deep-block" },
      "why": "`suppress` with `requires_approval: true` may only ask; this is semantic rule 1 in the DSL spec.",
      "event": {
        "type": "focus_block_started",
        "timestamp": "2026-11-20T03:00:00.000Z",
        "source": "manual",
        "context": { "app": "Code", "project": "agent-gate", "language": "typescript" },
        "duration_seconds": null
      }
    }
  ]
}
