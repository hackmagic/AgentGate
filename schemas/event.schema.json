{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guidance-runtime.dev/schemas/event.schema.json",
  "title": "GuidanceEvent",
  "description": "Normalised event emitted by an event adapter before policy evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "timestamp"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "enum": [
        "focus_block_started",
        "focus_block_ended",
        "app_switch",
        "idle_detected",
        "interruption",
        "notification_received"
      ]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "source": { "enum": ["activitywatch", "screenpipe", "manual"] },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app"],
      "properties": {
        "app": { "type": "string", "minLength": 1 },
        "project": { "type": ["string", "null"] },
        "language": { "type": ["string", "null"] }
      }
    },
    "duration_seconds": { "type": ["number", "null"], "minimum": 0 },
    "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
    "metadata": { "type": "object" }
  }
}
