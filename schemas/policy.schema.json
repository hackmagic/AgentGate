{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-gate.dev/schemas/policy.schema.json",
  "title": "AgentGatePolicy",
  "description": "A single AgentGate policy, exactly as stored on disk under packs/*/policies/*.yaml",
  "type": "object",
  "required": ["policy"],
  "additionalProperties": false,
  "properties": {
    "policy": { "$ref": "#/$defs/policy" }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "description", "priority", "trigger", "decision", "safety"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "version": { "type": "integer", "minimum": 1 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "priority": { "type": "integer" },
        "trigger": { "$ref": "#/$defs/trigger" },
        "conditions": { "$ref": "#/$defs/condition" },
        "decision": { "enum": ["suggest", "require_approval", "suppress", "allow"] },
        "action": { "$ref": "#/$defs/action" },
        "escalation": { "$ref": "#/$defs/escalation" },
        "safety": { "$ref": "#/$defs/safety" },
        "presentation": { "$ref": "#/$defs/presentation" }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "event": {
          "enum": [
            "focus_block_started",
            "focus_block_ended",
            "app_switch",
            "idle_detected",
            "interruption",
            "notification_received"
          ]
        },
        "context": { "$ref": "#/$defs/triggerContext" }
      }
    },
    "triggerContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "project": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "language": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      }
    },
    "condition": {
      "anyOf": [
        { "$ref": "#/$defs/conditionGroupAll" },
        { "$ref": "#/$defs/conditionGroupAny" },
        { "$ref": "#/$defs/conditionGroupNot" },
        { "$ref": "#/$defs/conditionLeaf" }
      ]
    },
    "conditionGroupAll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all"],
      "properties": { "all": { "type": "array", "items": { "$ref": "#/$defs/condition" }, "minItems": 1 } }
    },
    "conditionGroupAny": {
      "type": "object",
      "additionalProperties": false,
      "required": ["any"],
      "properties": { "any": { "type": "array", "items": { "$ref": "#/$defs/condition" }, "minItems": 1 } }
    },
    "conditionGroupNot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not"],
      "properties": { "not": { "$ref": "#/$defs/condition" } }
    },
    "conditionLeaf": {
      "description": "Dynamic facet comparison, e.g. {app: vscode, focus_score: '> 70'}. Evaluated by src/policy/conditions.ts.",
      "type": "object"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "scope": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "parameters": { "type": "object" }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after_minutes", "action"],
      "properties": {
        "after_minutes": { "type": "integer", "minimum": 1 },
        "action": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["suggest", "require_approval", "suppress"] }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_approval", "reversible", "audit_level"],
      "properties": {
        "requires_approval": { "type": "boolean" },
        "rationale": { "type": "string", "maxLength": 500 },
        "reversible": { "type": "boolean" },
        "audit_level": { "enum": ["full", "summary", "none"] }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "animation_hint": { "enum": ["idle_shift", "stretch", "alert", "thinking"] },
        "bubble_text": { "type": "string", "minLength": 1, "maxLength": 120 },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/presentationAction" },
          "minItems": 1,
          "maxItems": 3
        }
      }
    },
    "presentationAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "action_id"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 20 },
        "action_id": { "enum": ["approve", "dismiss", "mute_1h"] }
      }
    }
  }
}
