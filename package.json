{
  "name": "agent-gate",
  "version": "0.9.0",
  "private": false,
  "description": "AgentGate — compile your personal boundaries into portable, auditable policy for any AI agent (AGENTS.md / SKILL.md / MCP).",
  "keywords": [
    "ai-agent",
    "mcp",
    "policy-engine",
    "agent-gate",
    "agent-policy",
    "guardrails",
    "activitywatch",
    "focus",
    "typescript"
  ],
  "license": "MIT",
  "author": "hackmagic",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "default": "./dist/mcp/server.js"
    },
    "./pet": {
      "types": "./dist/pet/bridge.d.ts",
      "default": "./dist/pet/bridge.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "gate": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "packs",
    "docs",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/check-boundaries.mjs",
    "test": "node scripts/run-tests.mjs",
    "validate-specs": "node --import tsx scripts/validate-specs.ts",
    "verify-i18n": "node scripts/verify-i18n.mjs",
    "lint-docs": "node scripts/lint-docs.mjs",
    "audit-schemas": "node scripts/audit-schemas.mjs",
    "verify-integrations": "node integrations/dsh-agent-gate-pet/test/verify-host.mjs && node integrations/dsh-agent-gate-pet/test/verify-client.mjs",
    "check": "npm run typecheck && npm run lint && npm run verify-i18n && npm run lint-docs && npm run test && npm run validate-specs && npm run audit-schemas && npm run build && npm run verify-integrations"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
