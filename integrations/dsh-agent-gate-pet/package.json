{
  "name": "dsh-agent-gate-pet",
  "version": "0.1.0",
  "private": true,
  "description": "Surface AgentGate approval prompts in a DSH host: a GateSignal becomes a prompt the user can approve, dismiss or silence, and the answer goes back to the engine.",
  "type": "module",
  "main": "./host/index.js",
  "exports": {
    ".": "./host/index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host",
    "client",
    "locale",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
